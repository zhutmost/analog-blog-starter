{
  "name": "analog-blog-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun scripts/sync-site-assets.ts",
    "predev": "bun scripts/sync-site-assets.ts",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "oxlint",
